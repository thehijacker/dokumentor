# Example Environment Variables
# Copy this file to .env and configure for your environment

# Application
APP_SECRET_KEY=your-secret-key-here
# Generate a secure secret key (recommended):
# Linux/macOS:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Windows (PowerShell):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# After generating, set APP_SECRET_KEY to the generated value above (do not commit secrets to VCS)
APP_DEBUG=false
APP_SECURE_COOKIES=false

# Database
DATABASE_PATH=./data/documents.db

# Storage
DOCUMENTS_PATH=./documents
WATCH_FOLDER=./watch_folder

# Authentication
ENABLE_REGISTRATION=true

# OCR
OCR_DEFAULT_LANGUAGES=eng,slv
TESSERACT_PATH=

# PDF
PDF_DECRYPT_PASSWORDS=,password,123456

# AI
AI_PROVIDER=internal
AI_MODEL=simple
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Watch Folder
WATCH_FOLDER_ENABLED=true
